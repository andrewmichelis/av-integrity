    affiliation: KnackMentor
version: "0.1.0"
date-released: "2026-07-15"
license: Apache-2.0
repository-code: "https://github.com/andrewmichelis/av-integrity"
url: "https://knackmentor.com"
keywords:
  - sensor fusion
  - Kalman filter
  - state estimation
  - fault detection
  - autonomous vehicles
  - simulation
  - systems integration
